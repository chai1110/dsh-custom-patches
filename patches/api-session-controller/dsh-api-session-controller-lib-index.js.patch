 	/**
+	* Rewrite the LAST user message of a session and regenerate from it,
+	* Codex-style: the new text replaces the previous user message AND all
+	* assistant/tool surface nodes that followed it (they are shadowed by a
+	* surface replace, never deleted from the append-only log), then the
+	* agent is woken to answer the edited prompt anew. Only the most recent
+	* user message is editable; everything before it stays read-only.
+	* @param request - Session identity and the replacement plain text.
+	* @returns acknowled after the rewrite was admitted.
+	*/
+	async editLastPrompt(request) {
+		const agent = await this.resolveAgent(request.sessionId);
+		if (agent.status !== "idle") {
+			// 编辑时 agent 正在工作：先取消当前回合（保留 inbox），随后 followup
+			// 会经 wakingAfterAbort 路径自动唤醒 driver 按 next-turn 重发。
+			agent.cancel({ kind: "user" }, { keepInbox: true });
+		}
+		if (request.text.trim() === "") throw new RemoteError("session/invalid-content", "the edited prompt must contain text", {});
+		const { session } = agent;
+		const nodes = session.surface.nodes;
+		let lastUserIndex = -1;
+		for (let i = nodes.length - 1; i >= 0; i--) {
+			const event = session.eventAt(nodes[i]);
+			if (event?.type === "user/message" && event.data.source?.kind === "user") {
+				lastUserIndex = i;
+				break;
+			}
+		}
+		if (lastUserIndex === -1) throw new RemoteError("session/nothing-to-edit", "this session has no user message to edit", {});
+		const startSeq = nodes[lastUserIndex];
+		const endSeq = nodes[nodes.length - 1];
+		const sourceEventSeqs = nodes.slice(lastUserIndex);
+		const message = createUserMessage({
+			content: [{
+				type: "text",
+				text: request.text
+			}],
+			source: {
+				kind: "user",
+				rpcId: request.requestId
+			}
+		});
+		try {
+			session.append("user/message", message, {
+				surfaceOp: {
+					op: "replace",
+					start: startSeq,
+					end: endSeq
+				},
+				sourceEventSeqs
+			});
+		} catch (error) {
+			throw new RemoteError("session/edit-rejected", `unable to rewrite the last message: ${String(error)}`, {});
+		}
+		agent.followup(message);
+		return { accepted: true };
+	}
